# Copy to .env.local for local development, and set the same variables in your host for production.

# Fine-grained GitHub token for the résumé repo (HrxSrv/My-Docs) only, with "Contents: Read and write".
# Lets the admin page change the active résumé. Optional for the public site (raises GitHub's rate limit).
GITHUB_TOKEN=

# GitHub OAuth app for admin sign-in (github.com/settings/developers → New OAuth App).
# Callback URL: http://localhost:3000/admin/callback locally, https://<your-domain>/admin/callback in production.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random string of 32+ characters that signs admin sessions, e.g. from `openssl rand -base64 32`.
SESSION_SECRET=

# Secret for the résumé repo's webhook (push events → https://<your-domain>/api/revalidate).
GITHUB_WEBHOOK_SECRET=
